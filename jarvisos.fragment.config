# Unified Kconfig fragment for linux-jarvisos
# Merges CachyOS 7.3 + BORE + ADIOS + BBRv3 + Omarchy desktop/laptop tuning + JarvisOS drivers/jarvis/
# Target hardware: Intel Alder Lake i5-1235U (x86-64-v3, Iris Xe, Intel SOF Audio, Realtek RTL8822CE)

# CachyOS Sauce & Compiler Optimizations
CONFIG_CACHY=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set

# Disable Rust kernel drivers and DWARF5/BTF debug bloat for 7.4 GiB RAM safety
# (BORE scheduler is used instead of sched_ext; avoids pahole >4 GiB swap OOM)
# CONFIG_RUST is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_SCHED_CLASS_EXT is not set

# Architecture (portable x86-64-v3 covers Alder Lake AVX2/AVX-VNNI and KVM -cpu host)
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_ENERGY_MODEL=y
CONFIG_X86_INTEL_PSTATE=y

# CPU Scheduler & Low-Latency Preemption (BORE + 1000 Hz + full dynamic preempt)
CONFIG_SCHED_BORE=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y

# I/O Schedulers (ADIOS 3.3.0 default for NVMe + BFQ + Kyber)
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y

# Networking (BBRv3 + Fair Queue pacing for streaming voice APIs)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_TCP_CONG_BBR3=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_FQ=y

# Memory & zram compatibility (zswap disabled on boot via cmdline when using zram0)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_ZSWAP_DEFAULT_ON is not set

# Cgroups, Async I/O & Agent Isolation / Sandboxing
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_IO_URING=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUDIT=y

# Release integrity: every loadable module must carry a signature trusted by
# this kernel. Keep the same policy in KVM and on the deployed host.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y

# Audio / Hardware / Input / KVM Guest Support (keep SOF/GPU/WiFi modular for firmware loading)
CONFIG_SND_HDA_PREALLOC_SIZE=0
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_RTW88_8822CE=m
CONFIG_BT_HCIBTUSB=m
CONFIG_INPUT_UINPUT=y
CONFIG_NTSYNC=m
CONFIG_KSMBD=m
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=m
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_DM_CRYPT=y

# JarvisOSLinux In-Tree Integration Driver (single jarvis.ko matching DIBS)
CONFIG_DIBS=y
CONFIG_DIBS_LO=y
CONFIG_KEYS=y
CONFIG_JARVIS=m
CONFIG_JARVIS_DIBS=y
CONFIG_JARVIS_SYSMON=y
CONFIG_JARVIS_POLICY=y
CONFIG_JARVIS_KEYS=y
